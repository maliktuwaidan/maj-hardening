# Template for /etc/galasin/galasin.env
# Real file lives on the server only, perms 600, owned by galasin-svc.
# systemd EnvironmentFile syntax: KEY=value, no `export`, no quotes unless value has spaces.

# --- web server ----
PHX_SERVER=true
PHX_HOST=service.galasin.com
PORT=4000

# --- secrets ----
# Generate with: sudo -iu galasin-svc bash -lc 'cd ~/galasin-services && mix phx.gen.secret'
SECRET_KEY_BASE=

# --- database ----
# Note port 15432 — non-default, matches the migrated cluster
DATABASE_URL=ecto://USER:PASS@localhost:15432/galasin_services_prod
POOL_SIZE=10

# --- application keys ----
ADMIN_API_KEY=
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
